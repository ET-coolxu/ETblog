# 站点（不要把站名/作者写死在组件里）
SITE_NAME=个人博客
AUTHOR_NAME=作者
SITE_URL=http://localhost:3000

# 后台（阶段 4 才会用到）
ADMIN_PASSWORD=change-me
SESSION_SECRET=change-me-to-a-long-random-string
ADMIN_USER=admin

# Docker Compose + Caddy
# 本地保持 :80（HTTP）。生产改成真实域名，例如 blog.example.com，不要带 http://
SITE_DOMAIN=:80
CADDY_EMAIL=admin@localhost
