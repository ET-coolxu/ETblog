# 站点（不要把站名/作者写死在组件里）
SITE_NAME=个人博客
AUTHOR_NAME=作者
SITE_URL=http://localhost:3000

# 后台（仅本地开发。生产密码与 SESSION_SECRET 只写在 VPS 的 .env，不要提交 Git）
ADMIN_PASSWORD=dev-only-change-me
SESSION_SECRET=change-me-to-a-long-random-string
ADMIN_USER=admin

# Docker Compose + Caddy
# 本地必须保持 :80（HTTP）。不要写成 localhost，否则 Caddy 只在容器内监听。
# 生产：SITE_DOMAIN=coolxu.com（不要带 http://）
# 生产：CADDY_EMAIL 必须是邮箱（例如 you@example.com），不能填域名。
# 生产：若 SITE_NAME 含撇号，必须写成 SITE_NAME="CoolXu's Blog"
SITE_DOMAIN=:80
CADDY_EMAIL=admin@localhost
